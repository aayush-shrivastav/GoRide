{
  "expo": {
    "name": "GoRide",
    "slug": "goride",
    "scheme": "goride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "GoRide needs speech recognition to understand Hindi and Hinglish booking requests.",
        "NSMicrophoneUsageDescription": "GoRide needs microphone access so you can book rides by voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.anonymous.goride"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GoRide requires location access to find nearby rides and track your route."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "GoRide needs microphone access so you can book rides by voice.",
          "speechRecognitionPermission": "GoRide needs speech recognition to understand Hindi and Hinglish booking requests.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-font",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "44a0e738-557a-4625-9727-5d5bcd8912a3"
      }
    }
  }
}
